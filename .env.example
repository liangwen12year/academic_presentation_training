# ElevenLabs API key (required for golden reference audio)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# LLM for script generation when speaker notes are missing
# Option 1: OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic key for the optional slide-image speaker-script generator
ANTHROPIC_API_KEY=your-anthropic-api-key

# Option 2: Google Gemini
GOOGLE_API_KEY=your-google-api-key

# Which LLM provider to use: "openai" or "gemini"
LLM_PROVIDER=openai

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base

# Optional: use the research seed prompt to generate scripts from slide images.
# This sends each target slide and its available neighboring slides to the
# selected provider during upload. Leave the prompt path unset for the original
# text/notes workflow. Claude Haiku 5.5 is the default generator.
# SPEAKER_SCRIPT_PROMPT_PATH=prompts/speaker_script_gen/seed_v1_multimodal.md
# SPEAKER_SCRIPT_PROVIDER=anthropic
# SPEAKER_SCRIPT_MODEL=claude-haiku-5-5
# SPEAKER_SCRIPT_REASONING_EFFORT=medium
# SPEAKER_SCRIPT_TARGET_DURATION_SECONDS=30

# To use GPT-5.6 Luna instead, set SPEAKER_SCRIPT_PROVIDER=openai and
# SPEAKER_SCRIPT_MODEL=gpt-5.6-luna, and provide OPENAI_API_KEY above.
